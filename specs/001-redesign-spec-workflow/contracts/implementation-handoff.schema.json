{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://andvl1.dev/omp-workflows/specification/implementation-handoff.schema.json",
  "title": "Executor-Neutral Implementation Handoff",
  "type": "object",
  "required": [
    "schema_version",
    "handoff_id",
    "handoff_digest",
    "feature_id",
    "source_kind",
    "artifact_versions",
    "scope",
    "requirements",
    "decisions",
    "tasks",
    "verification",
    "validation_refs",
    "approval_refs",
    "language",
    "constitution_binding",
    "constitution_impact_ref",
    "risks",
    "open_decisions",
    "execution_choices",
    "status"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "handoff_id": {
      "type": "string"
    },
    "handoff_digest": {
      "type": "string"
    },
    "feature_id": {
      "type": "string"
    },
    "source_kind": {
      "type": "string",
      "enum": ["native", "external", "legacy"]
    },
    "artifact_versions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["artifact_id", "kind", "version", "sha256"],
        "additionalProperties": false,
        "properties": {
          "artifact_id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": ["specify", "plan", "tasks", "import_snapshot", "supplement"]
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string"
          }
        }
      }
    },
    "scope": {
      "type": "object",
      "required": ["in_scope", "out_of_scope", "constraints"],
      "additionalProperties": false,
      "properties": {
        "in_scope": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "out_of_scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["requirement_id", "statement", "acceptance_ids", "source_refs"],
        "additionalProperties": false,
        "properties": {
          "requirement_id": {
            "type": "string"
          },
          "statement": {
            "type": "string"
          },
          "acceptance_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["decision_id", "decision", "rationale", "requirement_ids"],
        "additionalProperties": false,
        "properties": {
          "decision_id": {
            "type": "string"
          },
          "decision": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          },
          "requirement_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "task_id",
          "title",
          "requirement_ids",
          "depends_on",
          "expected_outcome",
          "affected_scope",
          "completion_evidence",
          "parallel_safe"
        ],
        "additionalProperties": false,
        "properties": {
          "task_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "requirement_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "expected_outcome": {
            "type": "string"
          },
          "affected_scope": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "completion_evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "parallel_safe": {
            "type": "boolean"
          }
        }
      }
    },
    "verification": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["verification_id", "requirement_ids", "task_ids", "expected_evidence"],
        "additionalProperties": false,
        "properties": {
          "verification_id": {
            "type": "string"
          },
          "requirement_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "task_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "expected_evidence": {
            "type": "string"
          }
        }
      }
    },
    "validation_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "approval_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "language": {
      "type": "string"
    },
    "constitution_binding": {
      "type": "object",
      "required": [
        "provider_id",
        "path",
        "version",
        "content_sha256",
        "semantic_hash",
        "validation_ref",
        "bound_at"
      ],
      "additionalProperties": false,
      "properties": {
        "provider_id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "content_sha256": {
          "type": "string"
        },
        "semantic_hash": {
          "type": "string"
        },
        "validation_ref": {
          "type": "string"
        },
        "bound_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "constitution_impact_ref": {
      "type": ["string", "null"]
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "open_decisions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "execution_choices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["do-work", "cto"]
      }
    },
    "status": {
      "type": "string",
      "enum": ["candidate", "ready", "stale"]
    },
    "import_snapshot_ref": {
      "type": ["string", "null"]
    },
    "compatibility_supplement_ref": {
      "type": ["string", "null"]
    }
  }
}
