  "requirements": [
    {
      "requirement_id": "FR-101",
      "statement": "The system MUST retry a timed-out card charge up to 3 times with exponential backoff (1s, 2s, 4s) before giving up.",
      "acceptance_ids": [
        "A-101",
        "A-102",
        "A-103"
      ],
      "source_refs": [
        "imported/payment-retry/requirements.md"
      ]
    },
    {
      "requirement_id": "FR-102",
      "statement": "Every retried charge MUST reuse the same provider idempotency key as the first attempt.",
      "acceptance_ids": [
        "A-101",
        "A-102",
        "A-103"
      ],
      "source_refs": [
        "imported/payment-retry/requirements.md"
      ]
    },
    {
      "requirement_id": "FR-103",
      "statement": "After the final failed attempt the system MUST write a dead-letter record with the order id, attempt count, and provider error code.",
      "acceptance_ids": [
        "A-101",
        "A-102",
        "A-103"
      ],
      "source_refs": [
        "imported/payment-retry/requirements.md"
      ]
    }
  ],
  "decisions": [
    {
      "decision_id": "D-101",
      "decision": ". Deterministic in-process backoff",
      "rationale": "Fixed 1s/2s/4s schedule; no scheduler service. Traces to FR-101.",
      "requirement_ids": [
        "FR-101"
      ]
    },
    {
      "decision_id": "D-102",
      "decision": ". Reuse the orders idempotency column",
      "rationale": "The existing column stores the provider idempotency key. Traces to FR-102.",
      "requirement_ids": [
        "FR-102"
      ]
    },
    {
      "decision_id": "D-103",
      "decision": ". Persist final retry exhaustion in the dead-letter audit",
      "rationale": "Reuse the existing dead-letter/audit failure persistence when retries are finally exhausted, including the order id, attempt count, and provider error code. Traces to FR-103.",
      "requirement_ids": [
        "FR-103"
      ]
    }
