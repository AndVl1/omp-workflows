{
  "name": "bug-fix",
  "title": "Quick Bug Fix",
  "description": "BUG_FIX with an obvious fix. Diagnostics → fix → review. For bugs needing iterative verification, the interpreter promotes to the debug-cycle profile (autonomous mode always uses debug-cycle).",
  "completion_intent": {
    "mode": "complete_outcome",
    "acceptance": "dod_and_artifacts",
    "source": "workflow_policy",
    "rationale": "Bug-fix workflows complete a verified fix with durable diagnosis, review, and DoD artifacts."
  },
  "checkpoint_policy": {
    "default": "required_human",
    "scope": "decision",
    "hard_human": ["product_approval", "security", "destructive_side_effect", "production", "bundle_activation", "migration_cutover"],
    "rules": {
      "approve_fix": { "kind": "implementation_approval", "default": "required_human", "allowed_decisions": ["proceed", "reject"], "phase": "before_advance", "rationale": "Applying a fix requires explicit approval." }
    },
    "source": "profile",
    "policy_version": 1,
    "rationale": "Conservative typed opt-in policy keeps fix approval human-required."
  },
  "match": { "type": ["BUG_FIX"] },
  "stages": [
    {
      "id": "discovery",
      "title": "Discovery",
      "type": "orchestrator",
      "gate": "branch_created",
      "produces": "discovery"
    },
    {
      "id": "diagnose",
      "title": "Diagnostics",
      "type": "single",
      "role": "diagnostics",
      "consumes": ["discovery"],
      "gate": "root_cause_documented",
      "produces": ["diagnosis", "dod"]
    },
    {
      "id": "implementation",
      "title": "Apply Fix",
      "type": "single",
      "role": "${scope.dev_agent}",
      "consumes": ["diagnosis"],
      "gate": "root_cause_documented",
      "checkpoint": "approve_fix",
      "autonomous": "proceed",
      "produces": "implementation"
    },
    {
      "id": "review",
      "title": "Verify Fix",
      "type": "single",
      "role": "qa",
      "consumes": ["implementation", "diagnosis"],
      "gate": "verdict != reject",
      "produces": "review"
    },
    {
      "id": "manual_qa",
      "title": "Manual QA (fixed code)",
      "type": "single",
      "role": "manual-qa",
      "consumes": ["review", "implementation", "diagnosis"],
      "skip_if": "!scope.has_runtime",
      "gate": "manual_qa.verdict != FAIL",
      "produces": "manual_qa"
    },
    {
      "id": "summary",
      "title": "Summary",
      "type": "orchestrator",
      "consumes": ["implementation", "diagnosis", "review", "manual_qa", "dod"],
      "gate": "dod_complete",
      "produces": "summary"
    }
  ]
}
