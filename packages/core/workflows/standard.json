{
  "name": "standard",
  "title": "Standard Feature Development",
  "description": "MEDIUM features. Single architect (no parallel options), still clarifies and reviews.",
  "completion_intent": {
    "mode": "complete_outcome",
    "acceptance": "dod_and_artifacts",
    "source": "workflow_policy",
    "rationale": "Standard workflows complete the requested outcome with durable artifacts and DoD evidence."
  },
  "checkpoint_policy": {
    "default": "required_human",
    "scope": "decision",
    "hard_human": ["product_approval", "security", "destructive_side_effect", "production", "bundle_activation", "migration_cutover"],
    "rules": {
      "confirm_understanding": { "kind": "clarification", "default": "required_human", "allowed_decisions": ["proceed", "revise"], "phase": "before_advance", "rationale": "The user confirms the normalized understanding before the workflow advances." },
      "user_answers": { "kind": "clarification", "default": "required_human", "allowed_decisions": ["proceed", "revise", "reject"], "phase": "before_advance", "rationale": "Clarifying answers are explicit user input, not an autonomous prose interpretation." },
      "user_choice": { "kind": "architecture_choice", "default": "required_human", "allowed_decisions": ["proceed", "revise", "reject"], "phase": "before_advance", "rationale": "The user owns the architecture choice." },
      "approve_implementation": { "kind": "implementation_approval", "default": "required_human", "allowed_decisions": ["proceed", "reject"], "phase": "before_advance", "rationale": "Implementation approval remains an explicit checkpoint." },
      "fix_decision": { "kind": "review_fix", "default": "required_human", "allowed_decisions": ["proceed", "defer", "reject"], "phase": "before_advance", "rationale": "Review-fix disposition must be explicit." },
      "fix_selection": { "kind": "review_fix", "default": "required_human", "allowed_decisions": ["proceed", "defer", "reject"], "phase": "before_advance", "rationale": "The user selects which review fixes are accepted." }
    },
    "source": "profile",
    "policy_version": 1,
    "rationale": "Conservative typed opt-in policy: every declared checkpoint is human-required until a trusted policy transition explicitly permits automation."
  },
  "match": { "type": ["FEATURE", "REFACTOR", "OPS"], "complexity": ["MEDIUM", "COMPLEX"] },
  "stages": [
    {
      "id": "discovery",
      "title": "Discovery",
      "type": "orchestrator",
      "gate": "branch_created",
      "checkpoint": "confirm_understanding",
      "autonomous": "log confirmed understanding, continue",
      "produces": "discovery"
    },
    {
      "id": "exploration",
      "title": "Codebase Exploration",
      "type": "consilium",
      "roles": ["analyst", "tech-researcher"],
      "parallel": true,
      "consumes": ["discovery"],
      "produces": ["exploration", "dod"],
      "fan_in": {
        "resolutions": [
          {
            "artifact": "exploration",
            "field": "summary",
            "strategy": "first_slot",
            "rationale": "Parallel exploration slots each summarize the codebase from their own angle; every slot's full summary stays available in its slot-scoped artifact (<id>-<slot>.json). The shared artifact deterministically resolves the required 'summary' scalar to the first roster slot's contribution so downstream stages receive a stable synthesis. Every applied disagreement is recorded in the synthesis provenance (conflicts) with the winning slot and losing values — never discarded silently."
          }
        ]
      }
    },
    {
      "id": "clarify",
      "title": "Clarifying Questions",
      "type": "orchestrator",
      "consumes": ["discovery", "exploration"],
      "checkpoint": "user_answers",
      "autonomous": "abort needs-human if confidence LOW; else resolve with documented defaults",
      "produces": "clarifications"
    },
    {
      "id": "architecture",
      "title": "Architecture Design (single)",
      "type": "single",
      "role": "architect",
      "consumes": ["exploration", "clarifications"],
      "checkpoint": "user_choice",
      "autonomous": "proceed with proposed design",
      "produces": "architecture"
    },
    {
      "id": "implementation",
      "title": "Implementation",
      "type": "single",
      "role": "${scope.dev_agent}",
      "consumes": ["architecture", "exploration"],
      "checkpoint": "approve_implementation",
      "autonomous": "proceed",
      "produces": "implementation"
    },
    {
      "id": "code_review",
      "title": "Code Review",
      "type": "consilium",
      "roles": ["code-reviewer"],
      "parallel": true,
      "conditional": [
        { "if": "scope.has_security", "add": "security-tester" },
        { "if": "scope.has_infra", "add": "devops" }
      ],
      "consumes": ["implementation", "architecture"],
      "gate": "verdict != reject",
      "checkpoint": "fix_decision",
      "autonomous": "fix CRITICAL+HIGH, then continue",
      "produces": "review"
    },
    {
      "id": "review_fixes",
      "title": "Review Fixes",
      "type": "single",
      "role": "${scope.dev_agent}",
      "consumes": ["review"],
      "checkpoint": "fix_selection",
      "autonomous": "fix CRITICAL+HIGH, defer the rest",
      "skip_if": "review.findings == []"
    },
    {
      "id": "manual_qa",
      "title": "Manual QA (fixed code)",
      "type": "single",
      "role": "manual-qa",
      "consumes": ["review", "implementation", "architecture"],
      "skip_if": "!scope.has_runtime",
      "gate": "manual_qa.verdict != FAIL",
      "produces": "manual_qa"
    },
    {
      "id": "qa_tests",
      "title": "Automated Tests",
      "type": "single",
      "role": "qa",
      "consumes": ["manual_qa", "implementation", "architecture"],
      "gate": "manual_qa.verdict == PASS || !scope.has_runtime",
      "produces": "qa_tests"
    },
    {
      "id": "summary",
      "title": "Summary",
      "type": "orchestrator",
      "consumes": ["implementation", "review", "manual_qa", "qa_tests", "dod"],
      "gate": "dod_complete",
      "produces": "summary"
    }
  ]
}
