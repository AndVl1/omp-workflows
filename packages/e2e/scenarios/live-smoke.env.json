{
  "schema_version": 1,
  "runtime": {
    "binary": "omp"
  },
  "artifacts": {
    "core": {
      "source": "../../core"
    },
    "fullstack": {
      "source": "../../fullstack"
    }
  },
  "scenario": {
    "id": "live-smoke",
    "path": "./live-smoke.json"
  },
  "model": "openai-codex/gpt-5.6-luna",
  "auth": {
    "mode": "native-host-broker",
    "provider": "openai-codex",
    "start_local": true,
    "bind": "127.0.0.1:8765"
  },
  "timeout_ms": 120000,
  "retention": "cleanup"
}
