{
  "name": "@andvl1/omp-workflows-e2e",
  "version": "0.1.2",
  "description": "Interactive UX E2E test framework for omp + omp-workflows: spawns a real omp PTY session in a scratch project, drives a workflow like a human UX tester, and emits a manual_qa-compatible report.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "ux-e2e": "./dist/cli.js"
  },
  "files": [
    "dist",
    "assets",
    "scenarios",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx test/*.test.ts"
  },
  "dependencies": {
    "node-pty": "^1.1.0",
    "ws": "^8.18.0",
    "@xterm/xterm": "^5.5.0",
    "@xterm/addon-fit": "^0.10.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.10",
    "tsx": "^4.19.0",
    "playwright": "^1.49.0"
  },
  "engines": {
    "node": ">=20"
  }
}
