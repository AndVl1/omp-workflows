{
  "name": "@andvl1/omp-workflows-e2e",
  "version": "0.2.0",
  "description": "Manifest-backed, isolated omp + omp-workflows acceptance harness with provider-free and OAuth-backed workflow verification.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "ux-e2e": "./dist/cli.js"
  },
  "files": [
    "dist",
    "assets",
    "scenarios",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx test/*.test.ts",
    "test:oauth-refresh": "npm --silent run build && node dist/cli.js oauth-refresh --json"
  },
  "dependencies": {
    "node-pty": "^1.1.0",
    "ws": "^8.18.0",
    "@xterm/xterm": "^5.5.0",
    "@xterm/addon-fit": "^0.10.0"
  },
  "devDependencies": {
    "@oh-my-pi/pi-ai": "18.0.6",
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.10",
    "tsx": "^4.19.0",
    "playwright": "^1.49.0"
  },
  "engines": {
    "node": ">=20"
  }
}
