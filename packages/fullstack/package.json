{
  "name": "@andvl1/omp-workflows-fullstack",
  "version": "0.25.1",
  "description": "Protocol-v2 fullstack workflow provider with immutable descriptor/catalog publication and provider-owned non-canonical commands. Depends on @andvl1/omp-workflows-core as a peer.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./commands": "./commands/",
    "./commands/*": "./commands/*"
  },
  "omp": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "files": [
    "dist",
    "agents",
    "skills",
    "commands",
    "tsconfig.commands.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.commands.json",
    "typecheck:commands": "tsc --noEmit -p tsconfig.commands.json",
    "test": "node --test --import tsx test/*.test.ts",
    "prepublishOnly": "npm run build && npm run typecheck"
  },
  "peerDependencies": {
    "@andvl1/omp-workflows-core": "^0.25.0",
    "@oh-my-pi/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "zod": "^3.25.76"
  },
  "engines": {
    "node": ">=20"
  }
}
