{
  "name": "@andvl1/omp-workflows-fullstack",
  "version": "0.21.0",
  "description": "Default team agents and skills for omp-workflows with extension-owned workflow commands and project-local compatibility commands. Pulls @andvl1/omp-workflows-core as peer.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./commands": "./commands/",
    "./commands/*": "./commands/*"
  },
  "omp": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "files": [
    "dist",
    "agents",
    "skills",
    "commands",
    "bin",
    "scripts",
    "tsconfig.commands.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.commands.json",
    "typecheck:commands": "tsc --noEmit -p tsconfig.commands.json",
    "test": "node --test --import tsx test/*.test.ts",
    "copy-commands": "node scripts/copy-commands.mjs",
    "postinstall": "node scripts/copy-commands.mjs || true",
    "prepublishOnly": "npm run build && npm run typecheck"
  },
  "bin": {
    "omp-workflows-copy-commands": "scripts/copy-commands.mjs"
  },
  "peerDependencies": {
    "@andvl1/omp-workflows-core": "^0.21.0",
    "@oh-my-pi/pi-coding-agent": "*"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0"
  },
  "engines": {
    "node": ">=20"
  }
}
