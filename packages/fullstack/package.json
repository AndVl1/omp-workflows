{
  "name": "@omp-workflows/fullstack",
  "version": "0.1.0",
  "description": "Default team bundle for omp-workflows: imports @omp-workflows/core, exports registerTeamWorkflow with fullstack defaults. Ships 17 agents + 31 skills bundled at publish time from @omp-workflows/content (../content) via the prepack script.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AndVl1/omp-workflows.git",
    "directory": "packages/fullstack"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "omp": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "files": [
    "dist",
    "agents",
    "skills",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "sync-content": "node ./scripts/sync-content.mjs",
    "prepack": "node ./scripts/sync-content.mjs",
    "postpack": "node ./scripts/sync-content.mjs --restore"
  },
  "peerDependencies": {
    "@omp-workflows/core": "0.1.x",
    "@oh-my-pi/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@omp-workflows/core": "0.1.0",
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
