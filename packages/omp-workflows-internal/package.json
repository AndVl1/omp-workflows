{
  "name": "@andvl1/omp-workflows-internal",
  "version": "0.0.0",
  "private": true,
  "description": "Private protocol-v2 workflow provider with a narrowed omp-* agent catalog. Publication is explicit, workspace-marker-gated admission; the core host owns canonical commands and tools.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "omp": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "files": [
    "dist",
    "agents",
    "workflows"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx test/*.test.ts"
  },
  "peerDependencies": {
    "@andvl1/omp-workflows-core": "^0.25.0",
    "@oh-my-pi/pi-coding-agent": ">=17.3 <19"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0"
  },
  "engines": {
    "node": ">=20"
  }
}
