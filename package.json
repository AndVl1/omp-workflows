{
	"name": "omp-workflows",
	"version": "0.1.0",
	"private": true,
	"description": "Profile-driven multi-stage workflow engine for omp — monorepo: core + fullstack bundle.",
	"license": "MIT",
	"type": "module",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"build": "npm run build --workspaces",
		"build:core": "npm run build -w @andvl1/omp-workflows-core",
		"build:fullstack": "npm run build -w @andvl1/omp-workflows-fullstack",
		"typecheck": "npm run typecheck --workspaces",
		"test": "npm run test --workspaces",
		"test:core": "npm run test -w @andvl1/omp-workflows-core",
		"test:fullstack": "npm run test -w @andvl1/omp-workflows-fullstack",
		"test:all": "npm run test --workspaces",
		"e2e": "npm --silent run build -w @andvl1/omp-workflows-e2e && node packages/e2e/dist/cli.js",
		"e2e:prepare": "npm --silent run e2e -- prepare",
		"e2e:doctor": "npm --silent run e2e -- doctor",
		"e2e:start": "npm --silent run e2e -- start",
		"e2e:stop": "npm --silent run e2e -- stop",
		"e2e:input": "npm --silent run e2e -- input",
		"e2e:ask": "npm --silent run e2e -- ask",
		"e2e:transcript": "npm --silent run e2e -- transcript",
		"e2e:report": "npm --silent run e2e -- report",
		"e2e:cleanup": "npm --silent run e2e -- cleanup",
		"e2e:verify": "npm --silent run e2e -- verify",
		"e2e:auth-broker": "npm --silent run e2e -- auth-broker",
		"e2e:oauth-refresh": "npm --silent run e2e -- oauth-refresh",
		"test:oauth-refresh": "npm --silent run e2e:oauth-refresh -- --json",
		"clean": "rm -rf packages/*/dist"
	},
	"engines": {
		"node": ">=20"
	}
}
